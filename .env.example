# Optional overrides for `docker compose up --build -d`.
# Compose works without this file. Copy to `.env` only when needed.
# Never commit `.env`. These corvin_dev* values are for development only.
# Published ports bind to 127.0.0.1 in compose.yaml by default.
#
# Build contexts default to sibling folders ../server and ../web.
# Override when checkouts live elsewhere (CI uses ./_server and ./_web):
# SERVER_BUILD_CONTEXT=../server
# WEB_BUILD_CONTEXT=../web

POSTGRES_USER=corvin
POSTGRES_PASSWORD=corvin_dev_only_change_me
POSTGRES_DB=corvin
POSTGRES_PORT=5432
REDIS_PORT=6379
SERVER_PORT=3000
WEB_PORT=8080

CORVIN_ENV=development
CORVIN_RP_ID=localhost
CORVIN_RP_ORIGIN=http://localhost:8080
CORVIN_OTP_PEPPER=corvin_dev_otp_pepper_change_me!!
